RewriteEngine on
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteRule ^index.html$ https://www.fam-t.co.jp [L,R=301]
RewriteRule ^about.html$ https://www.fam-t.co.jp/company/ [L,R=301]
RewriteRule ^description.html$ https://www.fam-t.co.jp/business/ [L,R=301]
RewriteRule ^agency.html$ https://www.fam-t.co.jp [L,R=301]
RewriteRule ^adoption.html$ https://www.fam-t.co.jp/career/ [L,R=301]
RewriteRule ^privacy.html$ https://www.fam-t.co.jp [L,R=301]
#%PHP_START%#
# Make no changes between _START and _END tag, generated automatically.
AddHandler application/x-lsphp56 .php
#%PHP_END%#

